{
  "name": "dsh-command-palette",
  "displayName": "DSH Command Palette",
  "description": "Command palette (⌘K) for the DeepSeek Harness Web GUI: keyboard-first quick entries over sessions, settings, and actions, with a customizable hotkey and a register extension point.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.7",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ]
}
